<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="17.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <!--
    Classic (non-SDK) VSSDK project. This is required, not nostalgia: the VSSDK build targets that
    compile the .vsct command table and produce a .vsix package only support this project style.

    IMPORTANT: this project builds on WINDOWS with Visual Studio 2022 and the "Visual Studio
    extension development" workload installed. It is deliberately NOT part of ReqnrollRunner.sln —
    that solution (Core + CLI + tests) builds anywhere, including CI on Linux. Use
    ReqnrollRunner.VisualStudio.sln to work on the extension.
  -->

  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />

  <PropertyGroup>
    <MinimumVisualStudioVersion>17.0</MinimumVisualStudioVersion>
    <VSToolsPath Condition="'$(VSToolsPath)' == ''">$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)</VSToolsPath>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <SchemaVersion>2.0</SchemaVersion>
    <ProjectGuid>{7E8E1A5C-4E2B-4C6F-9E2D-6A1B0C3D5E7F}</ProjectGuid>
    <ProjectTypeGuids>{82b43b9b-a64c-4715-b499-d71e9ca2bd60};{FAE04EC0-301F-11D3-BF4B-00C04F79EFBC}</ProjectTypeGuids>
    <OutputType>Library</OutputType>
    <AppDesignerFolder>Properties</AppDesignerFolder>
    <RootNamespace>ReqnrollRunner.Vsix</RootNamespace>
    <AssemblyName>ReqnrollRunner.Vsix</AssemblyName>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <UseCodebase>true</UseCodebase>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <IncludeDebugSymbolsInLocalVSIXDeployment>false</IncludeDebugSymbolsInLocalVSIXDeployment>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <CopyOutputSymbolsToOutputDirectory>true</CopyOutputSymbolsToOutputDirectory>
    <StartAction>Program</StartAction>
    <StartProgram Condition="'$(DevEnvDir)' != ''">$(DevEnvDir)devenv.exe</StartProgram>
    <StartArguments>/rootsuffix Exp</StartArguments>
    <DeployExtension Condition="'$(IsCIBuild)' == 'true'">False</DeployExtension>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Classic projects list framework references explicitly. System.Design is the non-obvious one:
      OleMenuCommandService derives from System.ComponentModel.Design.MenuCommandService, which lives
      there, so without it AddCommand does not resolve.
    -->
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Design" />
    <!-- MEF: the editor adornments are composed parts. -->
    <Reference Include="System.ComponentModel.Composition" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
    <!-- WPF, for the scenario adornments. -->
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="Adornments\ScenarioActionsAdornment.cs" />
    <Compile Include="Adornments\ScenarioActionsTextViewListener.cs" />
    <Compile Include="DebuggerAttacher.cs" />
    <Compile Include="EditorContext.cs" />
    <Compile Include="ReqnrollRunnerGuids.cs" />
    <Compile Include="ReqnrollRunnerOptions.cs" />
    <Compile Include="ReqnrollRunnerPackage.cs" />
    <Compile Include="RunnerOutputPane.cs" />
    <Compile Include="ScenarioCommandHandler.cs" />
    <Compile Include="SolutionBuilder.cs" />
  </ItemGroup>

  <ItemGroup>
    <VSCTCompile Include="ReqnrollRunnerPackage.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
    </VSCTCompile>
  </ItemGroup>

  <ItemGroup>
    <None Include="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
    </None>
    <!-- Referenced by the manifest's <License> element, so it has to ship inside the .vsix. -->
    <Content Include="LICENSE.txt">
      <IncludeInVSIX>true</IncludeInVSIX>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.9.37000" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.9.3184">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <!--
      Core's only dependency. It must be shipped inside the .vsix — Visual Studio will not resolve it
      from a NuGet cache at run time.
    -->
    <PackageReference Include="Gherkin" Version="42.0.1">
      <IncludeInVSIX>true</IncludeInVSIX>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ReqnrollRunner.Core\ReqnrollRunner.Core.csproj">
      <Project>{9C4E7B21-3D5A-4F18-8B6C-2E0D4A7F9C31}</Project>
      <Name>ReqnrollRunner.Core</Name>
      <IncludeOutputGroupsInVSIX>BuiltProjectOutputGroup%3bBuiltProjectOutputGroupDependencies%3bGetCopyToOutputDirectoryItems%3bSatelliteDllsProjectOutputGroup%3b</IncludeOutputGroupsInVSIX>
    </ProjectReference>
  </ItemGroup>

  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />

  <!--
    Guarded by Exists(), not just by VSToolsPath being non-empty. VSToolsPath always has a value
    (MSBuild derives it), so the original condition was effectively always true and the import failed
    outright on a machine without the "Visual Studio extension development" workload — which includes
    the GitHub-hosted Windows runners. With Exists(), the build falls back to the VSSDK targets that
    Microsoft.VSSDK.BuildTools brings in from NuGet, which is what lets CI package the .vsix.
  -->
  <Import Project="$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets" Condition="Exists('$(VSToolsPath)\VSSDK\Microsoft.VsSDK.targets')" />

</Project>
