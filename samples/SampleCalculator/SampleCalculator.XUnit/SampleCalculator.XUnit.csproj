<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>SampleCalculator.XUnit</RootNamespace>
    <IsPackable>false</IsPackable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!--
      Overridable so CI can build these samples against more than one Reqnroll release:
        dotnet build ... -p:ReqnrollVersion=*
      The whole design rests on Reqnroll emitting `#line <n>` first in each generated test method,
      so a generator change is the biggest external risk this project carries. The version matrix in
      CI is the early warning for it.
    -->
    <ReqnrollVersion Condition="'$(ReqnrollVersion)' == ''">3.3.4</ReqnrollVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Reqnroll.xUnit" Version="$(ReqnrollVersion)" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <!-- Reqnroll.xUnit 3.3.4 requires xunit.core >= 2.8.1; the SDK template's 2.4.2 conflicts. -->
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
